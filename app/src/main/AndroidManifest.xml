<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network access is for the daily public spam CSV only, NEVER for incoming calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <package android:name="com.android.incallui" />
        <package android:name="com.android.contacts" />
        <package android:name="com.miui.yellowpage" />
    </queries>
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <receiver
            android:name=".BootSyncReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <service android:name=".DailySpamSyncJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />
        <provider android:name=".RiskCacheProvider"
            android:authorities="dev.yellowpagetr.spam.cache"
            android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
