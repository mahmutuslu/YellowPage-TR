<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Used only after an explicit user-initiated OpenSpam lookup. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Allow UID validation of the Xiaomi packages querying the local cache. -->
    <queries>
        <package android:name="com.android.incallui" />
        <package android:name="com.android.contacts" />
        <package android:name="com.miui.yellowpage" />
    </queries>
    <application android:allowBackup="false" android:label="@string/app_name" android:description="@string/app_description" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/app_description" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <!-- LSPosed legacy API: preselect only the three Xiaomi packages used by this module. -->
        <meta-data android:name="xposedscope" android:resource="@array/yellowpage_recommended_scope" />
        <!-- No network in this provider; Binder UID is validated on every call. -->
        <provider android:name=".RiskCacheProvider"
            android:authorities="dev.yellowpagetr.spam.cache"
            android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
